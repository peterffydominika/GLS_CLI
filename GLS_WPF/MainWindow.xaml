<Window x:Class="GLS_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GLS_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="dtgAdatok" ColumnWidth="Auto" Grid.Column="0"/>

        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Dátum" FontWeight="Bold"/>
            <TextBox x:Name="tbxDatum" Height="20" Margin="0,0,0,10"/>

            <Label Content="Név" FontWeight="Bold"/>
            <TextBox x:Name="tbxNev" Height="20" Margin="0,0,0,10"/>

            <Label Content="Csomagok száma" FontWeight="Bold"/>
            <TextBox x:Name="tbxCsomagok" Height="20" Margin="0,0,0,10"/>

            <Label Content="Fogyasztás (l/100km)" FontWeight="Bold"/>
            <TextBox x:Name="tbxFogyasztas" Height="20" Margin="0,0,0,10"/>

            <Label Content="km" FontWeight="Bold"/>
            <TextBox x:Name="tbxKm" Height="20" Margin="0,0,0,10"/>

            <!-- Gombok -->
            <Button x:Name="btnFelvisz" Content="Felvitel" Height="30" Margin="0,5" Click="btnFelvisz_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="BtnModositas" Content="Módosítás" Height="30" Margin="0,5" Click="BtnModositas_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="BtnMentes" Content="Mentés" Height="30" Margin="0,5" Click="BtnMentes_Click" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
